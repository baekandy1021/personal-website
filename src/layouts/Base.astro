---
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}
const { title = site.title, description = site.description } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Kalam&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&display=swap"
    />
    <script is:inline>
      // Turn on the draw-in animation only if motion is allowed. This runs before first paint.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
        document.documentElement.classList.add('motion');
      }
    </script>
  </head>
  <body>
    <!-- Shared filter that gives every doodle a slightly shaky, hand-drawn line -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
      <filter id="wobble" x="-10%" y="-10%" width="120%" height="120%">
        <feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed="4" result="noise" />
        <feDisplacementMap in="SourceGraphic" in2="noise" scale="2.4" xChannelSelector="R" yChannelSelector="G" />
      </filter>
    </svg>

    <a class="skip" href="#main">Skip to content</a>
    <slot />

    <script is:inline>
      // Doodles draw themselves in the first time they scroll into view.
      if (document.documentElement.classList.contains('motion')) {
        const strokes = ':is(path,circle,line,ellipse):not(.f):not([stroke-dasharray])';
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('in');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px' }
        );
        document.querySelectorAll('.doodle.draw').forEach((svg) => {
          svg.querySelectorAll(strokes).forEach((el, i) => {
            el.setAttribute('pathLength', '1');
            el.style.setProperty('--i', String(i));
          });
          io.observe(svg);
        });
      }
    </script>
  </body>
</html>
