---
import { site } from '../data/site';
import Cup from './doodles/Cup.astro';
---
<section id="now" class="wrap section now">
  <div class="card">
    <svg class="blob" viewBox="0 0 400 240" preserveAspectRatio="none" aria-hidden="true">
      <path d="M14 30C40 6 140 10 220 8s160 4 172 34c10 40 4 120-8 160-14 30-120 30-200 30S30 236 16 206C2 170-8 64 14 30z" />
    </svg>
    <div class="inner">
      <div class="head">
        <p class="label">03 · Now</p>
        <h2>What I'm up to</h2>
        <p class="label updated">updated {site.now.updated}</p>
      </div>
      <dl>
        {
          site.now.items.map((item) => (
            <div>
              <dt class="label">{item.label}</dt>
              <dd>{item.text}</dd>
            </div>
          ))
        }
      </dl>
      <Cup class="cup" />
    </div>
  </div>
</section>

<style>
  .now {
    padding-top: 0;
  }
  .card {
    position: relative;
    max-width: 880px;
    isolation: isolate;
    padding: clamp(28px, 5vw, 56px);
  }
  .blob {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
  }
  .blob path {
    fill: rgba(138, 154, 123, 0.2);
  }
  .inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 6fr);
    gap: clamp(20px, 5vw, 56px);
  }
  h2 {
    font-size: var(--step-2);
    margin: 6px 0 10px;
  }
  dl {
    margin: 0;
    display: grid;
    gap: 16px;
  }
  dt {
    color: var(--clay-ink);
  }
  dd {
    margin: 2px 0 0;
    color: var(--ink-2);
  }
  .inner :global(.cup) {
    position: absolute;
    width: 62px;
    height: auto;
    right: -8px;
    bottom: -18px;
    transform: rotate(8deg);
  }
  @media (max-width: 760px) {
    .inner {
      grid-template-columns: 1fr;
    }
    .inner :global(.cup) {
      top: -14px;
      bottom: auto;
      width: 50px;
    }
  }
</style>
